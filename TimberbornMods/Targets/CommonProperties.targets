<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<PropertyGroup>
		<SteamApps Condition="'$(SteamApps)'==''">$(TIMBERBORN_STEAMAPPS)</SteamApps>
		<ModPath Condition="'$(ModPath)'=='' AND '$(SteamApps)'!=''">$(SteamApps)\workshop\content\1062090\</ModPath>

		<TimberbornVersion Condition="'$(TimberbornVersion)'==''">version-1.1</TimberbornVersion>

		<AssemblyPath Condition="'$(AssemblyPath)'=='' AND '$(SteamApps)'!=''">$(SteamApps)\common\Timberborn\Timberborn_Data\Managed</AssemblyPath>

		<GameSolutionFolder Condition="'$(GameSolutionFolder)'==''">$(MSBuildThisFileDirectory)..\</GameSolutionFolder>
		<GameModsFolder Condition="'$(GameModsFolder)'==''">$(MSBuildThisFileDirectory)..\..\staging\</GameModsFolder>
		<ModFolder Condition="'$(ModFolder)'==''">$(GameModsFolder)$(OutputModFolderName)\$(TimberbornVersion)\</ModFolder>

		<IsTestProject Condition="'$(IsTestProject)'==''">false</IsTestProject>

		<IsOptionalDll>false</IsOptionalDll>
		<IsOptionalDll Condition="'$(OptionalForModId)'!=''">true</IsOptionalDll>

		<!-- For ignoring Member Accessibility, see https://stackoverflow.com/a/79512179/653457 -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<Target Name="ValidateLocalReferencePaths" BeforeTargets="PrepareForBuild">
		<Error Condition="'$(AssemblyPath)'=='' OR !Exists('$(AssemblyPath)')"
			   Text="Set AssemblyPath to the Timberborn Managed directory, or use BuildSupport/Build-ConstructionSiteImports.ps1 -SteamApps with your Steam library." />
		<Error Condition="'$(ModPath)'=='' OR !Exists('$(ModPath)')"
			   Text="Set ModPath to workshop/content/1062090, or use BuildSupport/Build-ConstructionSiteImports.ps1 -SteamApps with your Steam library." />
	</Target>

	<Target Condition="!$(IsTestProject)" Name="PrepareFilesForCopy" AfterTargets="Build">
		<ItemGroup>
			<LocalizationFiles Include="$(OutputPath)Localizations\**\*.*" />
			<DllFiles Include="$(OutputPath)\**\*.dll" />
			<Assets Include="$(OutputPath)\Assets\**\*" />
			<AssetBundles Include="$(OutputPath)\AssetBundles\**\*" />
			<Sprites Include="$(OutputPath)\Sprites\**\*" />
			<Specifications Include="$(OutputPath)\Specifications\**\*" />
			<ModResources Include="$(OutputPath)\Resources\**\*" />
			<ModSounds Include="$(OutputPath)\Sounds\**\*" />
			<ModManifestFile Condition="!$(IsOptionalDll)" Include="$(OutputPath)\**\manifest.json" />
			<ModWorkshopDataFile Include="$(OutputPath)\**\workshop_data.json" />
			<RootCopyFile Include="$(OutputPath)Root\**\*" />

			<Blueprints Include="$(OutputPath)\Blueprints\**\*.blueprint.json"
				Exclude="$(OutputPath)\Blueprints\**\*.U7.blueprint.json" />
		</ItemGroup>
	</Target>

</Project>
